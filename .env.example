DATABASE_URL="postgresql://jeeam:jeeam@localhost:5432/jeeam_finance?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# Mot de passe initial des comptes créés par le seed (à changer à la 1re connexion)
SEED_PASSWORD="ChangeMe!2026"
# Stockage local des justificatifs (remplaçable par S3, voir src/lib/storage.ts)
STORAGE_DIR="./storage"
# Module IA (optionnel)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Protège /api/cron/* (appel par cron système ou Vercel Cron)
CRON_SECRET="change-me-too"

# ── Stockage des justificatifs : local (défaut) ou s3 ──
STORAGE_DRIVER="local"
# S3_BUCKET="jeeam-justificatifs"
# S3_REGION="eu-west-3"                 # "auto" pour Cloudflare R2
# S3_ENDPOINT=""                        # R2 / MinIO / Scaleway : URL du endpoint
# S3_FORCE_PATH_STYLE="false"           # "true" pour MinIO
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_SSE="AES256"                       # chiffrement côté serveur (AES256 ou aws:kms)

# Clé de chiffrement des secrets 2FA au repos (défaut : NEXTAUTH_SECRET). Ne pas la perdre : sinon, réinitialiser les 2FA.
# TOTP_ENC_KEY=""
